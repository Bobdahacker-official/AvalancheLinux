<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>AvalancheLinux</vendor>
  <action id="org.avalanche.install">
    <description>Install AvalancheLinux</description>
    <message>Authenticate to install AvalancheLinux on this computer</message>
    <icon_name>avalanche</icon_name>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/avalanche-installer/launch</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
